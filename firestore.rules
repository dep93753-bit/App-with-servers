rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(code) {
      return signedIn() &&
        get(/databases/$(database)/documents/classes/$(code)).data.ownerUid == request.auth.uid;
    }

    match /classes/{code} {
      // Anyone signed in can load a class IF they know its join code. Nobody can list all classes.
      allow get: if signedIn();
      // Only the teacher who created a class can change or delete it.
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Roster: a student writes only their own entry; only the teacher reads it.
      match /students/{uid} {
        allow create, update: if signedIn() && request.auth.uid == uid
                              && request.resource.data.name is string
                              && request.resource.data.name.size() <= 30;
        allow read, delete: if isOwner(code);
      }

      // Scores: a student can add their own results but never edit or read others; only the teacher reads.
      match /scores/{id} {
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                      && request.resource.data.name is string
                      && request.resource.data.name.size() <= 30;
        allow read, delete: if isOwner(code);
      }
    }
  }
}
