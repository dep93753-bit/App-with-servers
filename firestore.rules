rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(code) {
      return signedIn() &&
        get(/databases/$(database)/documents/classes/$(code)).data.ownerUid == request.auth.uid;
    }
    // The app's developer: may read everyone's usage record (no names or emails are in it).
    function isDev() {
      return signedIn() && request.auth.token.email == 'hatfieldnathan@oacsd.org' && request.auth.token.email_verified == true;
    }
    // Students the teacher removed AND blocked (their account ids are in the class's "blocked" list).
    // Signed-in person who has joined the class (has an entry on its roster).
    function isMember(code) {
      return signedIn() && exists(/databases/$(database)/documents/classes/$(code)/students/$(request.auth.uid));
    }
    function isBlocked(code) {
      return request.auth.uid in get(/databases/$(database)/documents/classes/$(code)).data.get('blocked', []);
    }

    // Each person's own profile (name, role, photo, saved question bank).
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // One small usage record per account: last visit, device, game plays per game and per day.
    // Each person writes only their own; only the developer can read them all.
    match /usage/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isDev());
      allow list: if isDev();
      allow create, update: if signedIn() && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['role', 'firstSeen', 'lastSeen', 'device', 'installed', 'plays', 'games', 'days', 'aiQuizzes', 'classes', 'sets', 'reads', 'writes']);
    }

    match /classes/{code} {
      // Anyone signed in can load a class IF they know its join code (unless the teacher blocked them).
      // Nobody can list all classes.
      allow get: if signedIn() && (resource == null || !(request.auth.uid in resource.data.get('blocked', [])));
      // A teacher can list only their own classes (to restore them on a new device).
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      // Only the teacher who created a class can change or delete it.
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Roster: a student writes only their own entry (name, and which assignments they ticked off);
      // only the teacher reads it. Blocked students can't rejoin.
      match /students/{uid} {
        allow create, update: if signedIn() && request.auth.uid == uid && !isBlocked(code)
                              && request.resource.data.name is string
                              && request.resource.data.name.size() <= 30;
        allow read, delete: if isOwner(code);
      }

      // Wall posts written by students (the teacher's own posts live on the class itself).
      // Classmates and the teacher can read them; a class member may post as themselves while the teacher
      // allows student posts; the teacher can delete any post, a student only their own.
      match /posts/{id} {
        allow read: if isOwner(code) || (isMember(code) && !isBlocked(code));
        allow create: if signedIn() && isMember(code) && !isBlocked(code)
                      && get(/databases/$(database)/documents/classes/$(code)).data.get('settings', {}).get('studentsCanPost', false) == true
                      && request.resource.data.keys().hasOnly(['uid', 'sid', 'name', 'text', 'time', 'at'])
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.name is string && request.resource.data.name.size() <= 30
                      && request.resource.data.text is string && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500;
        allow delete: if isOwner(code) || (signedIn() && resource.data.uid == request.auth.uid);
      }

      // Scores: a student can add their own results but never edit or read others; only the teacher reads.
      // Blocked students can't add any.
      match /scores/{id} {
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid && !isBlocked(code)
                      && request.resource.data.name is string
                      && request.resource.data.name.size() <= 30;
        allow read, delete: if isOwner(code);
      }
    }
  }
}
