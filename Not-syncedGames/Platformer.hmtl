<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>Blob Parkour</title>
<link href="https://fonts.googleapis.com/css2?family=Lilita+One&display=swap" rel="stylesheet">
<style>
:root{--ink:#2b2350;--card:#fff7e0;--accent:#ff8a3d;color-scheme:dark}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}
html,body{height:100%;margin:0;background:#2b2350;overflow:hidden;font-family:'Lilita One','Arial Rounded MT Bold',system-ui,sans-serif;touch-action:none}
canvas{position:fixed;inset:0;width:100%;height:100%;display:block}
.pill{background:#fff;color:var(--ink);border:3px solid var(--ink);border-radius:14px;box-shadow:0 4px 0 var(--ink);padding:4px 12px;font-size:18px;display:flex;gap:6px;align-items:center}
#hud{position:fixed;left:calc(10px + env(safe-area-inset-left,0px));top:calc(10px + env(safe-area-inset-top,0px));display:flex;gap:8px;flex-wrap:wrap}
#tools{position:fixed;right:calc(10px + env(safe-area-inset-right,0px));top:calc(10px + env(safe-area-inset-top,0px));display:flex;gap:8px}
#tools button{font:inherit;cursor:pointer;width:44px;padding:4px 0;justify-content:center}
#ctl{display:none;position:fixed;left:0;right:0;bottom:0;justify-content:space-between;align-items:flex-end;padding:0 calc(18px + env(safe-area-inset-right,0px)) calc(18px + env(safe-area-inset-bottom,0px)) calc(18px + env(safe-area-inset-left,0px));pointer-events:none}
#ctl.on{display:flex}
.cb{pointer-events:auto;width:78px;height:78px;border-radius:50%;background:rgba(255,255,255,.82);border:4px solid var(--ink);box-shadow:0 5px 0 var(--ink);display:grid;place-items:center;color:var(--ink);font-size:34px;touch-action:none}
.cb.down{transform:translateY(4px);box-shadow:0 1px 0 var(--ink);background:#ffd25e}
.cb.big{width:96px;height:96px;background:rgba(255,138,61,.92);font-size:20px}
.dp{display:flex;gap:14px}
.ov{position:fixed;inset:0;display:none;place-items:center;background:rgba(43,35,80,.72);padding:16px}
.ov.on{display:grid}
.card{background:var(--card);color:var(--ink);border:4px solid var(--ink);border-radius:24px;box-shadow:0 8px 0 var(--ink);padding:22px 26px;text-align:center;max-width:420px;width:100%}
.card h1{margin:0 0 4px;font-size:42px;line-height:1;font-weight:400}
.card p{margin:8px 0;font-size:18px;line-height:1.3}
.sw{display:flex;gap:10px;justify-content:center;margin:14px 0}
.sw button{width:42px;height:42px;border-radius:50%;border:4px solid var(--ink);cursor:pointer;padding:0}
.sw button.sel{transform:scale(1.18);box-shadow:0 0 0 4px #fff,0 0 0 7px var(--ink)}
.go{font:inherit;font-size:26px;background:var(--accent);color:#fff;border:4px solid var(--ink);border-radius:16px;box-shadow:0 5px 0 var(--ink);padding:8px 34px;cursor:pointer;margin-top:6px}
.go:active{transform:translateY(4px);box-shadow:0 1px 0 var(--ink)}
.hint{font-size:15px;opacity:.75}
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="hud"><div class="pill">🪙 <span id="hc">0/0</span></div><div class="pill">⏱ <span id="ht">0:00.0</span></div><div class="pill">💥 <span id="hd">0</span></div></div>
<div id="tools"><button class="pill" id="bm" aria-label="Sound">🔊</button><button class="pill" id="br" aria-label="Restart">↻</button></div>
<div id="ctl"><div class="dp"><div class="cb" data-k="l">◀</div><div class="cb" data-k="r">▶</div></div><div class="cb big" data-k="j">JUMP</div></div>
<div class="ov on" id="menu"><div class="card"><h1>Blob Parkour</h1><p>Hop, dash and spring your way to the goal flag. Grab every coin!</p><div class="sw" id="sw"></div><button class="go" id="play">Play</button><p class="hint">Arrow keys / WASD + Space, or use the on-screen buttons</p></div></div>
<div class="ov" id="win"><div class="card"><h1>You made it!</h1><p id="ws"></p><button class="go" id="again">Run again</button></div></div>
<script>
const $=id=>document.getElementById(id),cv=$('c'),ctx=cv.getContext('2d');
const T=32,H=448,WORLD=105*T,INK='#2b2350',GRAV=1900,SPEED=230;
let S=1,VW=800,VH=H,cam=0;
function resize(){const d=Math.min(devicePixelRatio||1,2);cv.width=innerWidth*d;cv.height=innerHeight*d;S=Math.min(cv.height/H,cv.width/640);VW=cv.width/S;VH=cv.height/S}
addEventListener('resize',resize);resize();
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
let LW=3;
function rr(x,y,w,h,r,f,s){ctx.beginPath();ctx.roundRect(x,y,w,h,r);if(f){ctx.fillStyle=f;ctx.fill()}if(s){ctx.lineWidth=LW;ctx.strokeStyle=INK;ctx.stroke()}}
function el(x,y,rx,ry,f,s,rot=0){ctx.beginPath();ctx.ellipse(x,y,Math.max(rx,.1),ry,rot,0,7);if(f){ctx.fillStyle=f;ctx.fill()}if(s){ctx.lineWidth=LW;ctx.strokeStyle=INK;ctx.stroke()}}
/* ---------- level ---------- */
const G=(x,y,w)=>({x:x*T,y:y*T,w:w*T,h:(14-y)*T,k:'g'});
const F=(x,y,w)=>({x:x*T,y:y*T,w:w*T,h:T,k:'f'});
const solids=[G(0,11,10),G(12,11,4),F(18,9,3),F(23,8,3),F(28,10,2),G(41,10,6),F(49,8,2),F(53,6,2),F(57,8,2),G(61,10,8),F(74,5,3),F(79,6,3),F(84,9,3),F(88,4,3),G(93,10,12)];
const movers=[
 {x:0,y:0,w:3*T,h:16,k:'m',ox:32*T,oy:10*T,ax:5*T,ay:0,sp:.9,dx:0,dy:0},
 {x:0,y:0,w:3*T,h:16,k:'m',ox:70*T,oy:7.5*T,ax:0,ay:2.5*T,sp:1.1,dx:0,dy:0}];
const all=[...solids,...movers];
const spikes=[[43,9],[44,9],[98,9],[99,9]].map(([a,b])=>({x:a*T,y:b*T}));
const spring={x:85*T,y:9*T,t:0};
const cps=[{x:62*T+16,gy:10*T,on:false},{x:89*T+16,gy:4*T,on:false}];
const start={x:2*T+16,gy:11*T,on:true};
const goal={x:102*T+16,gy:10*T};
const coins=[[4,10],[5,10],[6,10],[7,10],[13,10],[14,9],[15,10],[19,8],[20,8],[24,7],[25,7],[29,9],[33,9],[35,8],[37,9],[42,8],[45,7],[46,9],[50,7],[54,5],[58,7],[63,9],[65,9],[67,9],[71,7],[72,5],[75,4],[76,4],[80,5],[81,5],[85,5],[86,2],[89,3],[90,3],[95,9],[96,8],[100,9],[101,9]].map(([a,b])=>({x:a*T+16,y:b*T+16,got:false}));
const decor=[];let sd=7;const rnd=()=>(sd=(sd*16807)%2147483647)/2147483647;
solids.forEach(s=>{if(s.k=='g')for(let x=s.x+40;x<s.x+s.w-30;x+=70+rnd()*80){const r=rnd();decor.push({x,y:s.y,t:r<.4?0:r<.7?1:2,s:.8+rnd()*.5})}});
/* ---------- audio ---------- */
let ac,muted=false;
function beep(f,d=.1,ty='square',v=.04,f2){if(muted)return;try{ac=ac||new(window.AudioContext||webkitAudioContext)();const t=ac.currentTime,o=ac.createOscillator(),g=ac.createGain();o.type=ty;o.frequency.setValueAtTime(f,t);if(f2)o.frequency.exponentialRampToValueAtTime(f2,t+d);g.gain.setValueAtTime(v,t);g.gain.exponentialRampToValueAtTime(.001,t+d);o.connect(g);g.connect(ac.destination);o.start();o.stop(t+d)}catch(e){}}
/* ---------- input ---------- */
const K={l:0,r:0,j:0};let jp=false;
const km={ArrowLeft:'l',KeyA:'l',ArrowRight:'r',KeyD:'r',ArrowUp:'j',KeyW:'j',Space:'j'};
addEventListener('keydown',e=>{const k=km[e.code];if(k){e.preventDefault();if(k=='j'&&!K.j)jp=true;K[k]=1}});
addEventListener('keyup',e=>{const k=km[e.code];if(k)K[k]=0});
document.querySelectorAll('.cb').forEach(b=>{const k=b.dataset.k;
 const on=e=>{e.preventDefault();try{b.setPointerCapture(e.pointerId)}catch(_){}if(k=='j'&&!K.j)jp=true;K[k]=1;b.classList.add('down')};
 const off=e=>{K[k]=0;b.classList.remove('down')};
 b.addEventListener('pointerdown',on);['pointerup','pointercancel','lostpointercapture'].forEach(n=>b.addEventListener(n,off))});
if('ontouchstart' in window||matchMedia('(pointer:coarse)').matches)$('ctl').classList.add('on');
document.addEventListener('contextmenu',e=>e.preventDefault());
/* ---------- state ---------- */
const chars=[['#4d8dff','#2f64d6'],['#ff6b8b','#d94468'],['#ffb92e','#d98d0a'],['#4ed17a','#2a9f54'],['#a56bff','#7a42d6']];
let ci=0,state='menu',time=0,got=0,deaths=0,cp=start,tA=0,parts=[];
const pl={x:0,y:0,vx:0,vy:0,w:24,h:34,dir:1,ground:false,coy:0,buf:0,ride:null,t:0,sq:0,dead:0};
const sw=$('sw');chars.forEach((c,i)=>{const b=document.createElement('button');b.style.background=c[0];b.setAttribute('aria-label','Color '+(i+1));b.onclick=()=>{ci=i;[...sw.children].forEach((x,j)=>x.classList.toggle('sel',j==i))};sw.appendChild(b)});sw.children[0].classList.add('sel');
function spawn(){pl.x=cp.x-12;pl.y=cp.gy-pl.h-1;pl.vx=pl.vy=0;pl.ride=null;pl.ground=false;pl.dead=0;pl.sq=0}
function reset(){coins.forEach(c=>c.got=false);cps.forEach(c=>c.on=false);cp=start;got=0;deaths=0;time=0;spawn();cam=0;state='play'}
function burst(x,y,n,col,sp=160,up=0){for(let i=0;i<n;i++){const a=Math.random()*6.28,v=sp*(.3+Math.random()*.7);parts.push({x,y,vx:Math.cos(a)*v,vy:Math.sin(a)*v-up,l:.5+Math.random()*.3,m:.8,r:2+Math.random()*3,c:col})}}
function die(){if(pl.dead>0)return;pl.dead=.7;deaths++;burst(pl.x+12,pl.y+17,22,chars[ci][0],260,80);beep(300,.35,'sawtooth',.05,60)}
const ov=(a,b)=>a.x<b.x+b.w&&a.x+a.w>b.x&&a.y<b.y+b.h&&a.y+a.h>b.y;
/* ---------- update ---------- */
function update(dt){
 tA+=dt;
 movers.forEach(m=>{const px=m.x,py=m.y;m.x=m.ox+m.ax*(Math.sin(tA*m.sp)*.5+.5);m.y=m.oy+m.ay*Math.sin(tA*m.sp);m.dx=m.x-px;m.dy=m.y-py});
 parts.forEach(q=>{q.l-=dt;q.x+=q.vx*dt;q.y+=q.vy*dt;q.vy+=700*dt});parts=parts.filter(q=>q.l>0);
 if(spring.t>0)spring.t-=dt;
 if(state!='play')return;
 time+=dt;const p=pl;
 if(p.dead>0){p.dead-=dt;if(p.dead<=0)spawn();return}
 if(p.ride){p.x+=p.ride.dx;p.y+=p.ride.dy}
 const ax=K.r-K.l;
 if(ax)p.dir=ax;
 const acc=ax?(p.ground?2600:1700):(p.ground?2800:500);
 p.vx+=clamp(ax*SPEED-p.vx,-acc*dt,acc*dt);
 p.coy=p.ground?.1:p.coy-dt;p.buf=jp?.12:p.buf-dt;jp=false;
 if(p.buf>0&&p.coy>0){p.vy=-690;p.buf=0;p.coy=0;p.ground=false;p.ride=null;p.sq=-.22;burst(p.x+12,p.y+p.h,6,'#fff',90);beep(420,.14,'square',.035,820)}
 p.vy=Math.min(900,p.vy+GRAV*(p.vy<0&&!K.j?2.4:1)*dt);
 p.x+=p.vx*dt;
 for(const s of all)if(ov(p,s)){if(p.vx>0)p.x=s.x-p.w;else if(p.vx<0)p.x=s.x+s.w;else p.x=p.x+p.w/2<s.x+s.w/2?s.x-p.w:s.x+s.w;p.vx=0}
 p.x=clamp(p.x,0,WORLD-p.w);
 p.y+=p.vy*dt;const was=p.ground;p.ground=false;p.ride=null;
 for(const s of all)if(ov(p,s)){if(p.vy>=0){p.y=s.y-p.h;p.ground=true;if(s.k=='m')p.ride=s;if(!was&&p.vy>250){p.sq=.28;burst(p.x+12,p.y+p.h,6,'#fff',90)}p.vy=0}else{p.y=s.y+s.h;p.vy=0}}
 p.sq-=p.sq*Math.min(1,dt*12);
 p.t+=dt*13*clamp(Math.abs(p.vx)/SPEED,0,1);
 const hb={x:p.x+3,y:p.y+4,w:p.w-6,h:p.h-4};
 for(const s of spikes)if(ov(hb,{x:s.x+4,y:s.y+14,w:24,h:18}))die();
 if(p.y>H+80)die();
 if(ov(p,{x:spring.x+2,y:spring.y-12,w:28,h:12})&&p.vy>=0){p.vy=-880;p.ground=false;p.ride=null;spring.t=.3;p.sq=-.3;burst(spring.x+16,spring.y-8,10,'#ffd25e',140);beep(300,.3,'sine',.07,1100)}
 coins.forEach(c=>{if(!c.got&&Math.abs(c.x-(p.x+12))<22&&Math.abs(c.y-(p.y+17))<26){c.got=true;got++;burst(c.x,c.y,8,'#ffd25e',140);beep(880,.08,'square',.035,1320)}});
 cps.forEach(c=>{if(!c.on&&Math.abs(p.x+12-c.x)<30&&Math.abs(p.y+p.h-c.gy)<44){c.on=true;cp=c;burst(c.x,c.gy-40,14,'#6dff8a',180);beep(520,.25,'triangle',.06,1040)}});
 if(ov(p,{x:goal.x-18,y:goal.gy-96,w:36,h:96})){state='win';burst(goal.x,goal.gy-80,40,'#ffd25e',320);beep(660,.4,'triangle',.07,1320);
  $('ws').textContent='Time '+fmt(time)+' · '+got+'/'+coins.length+' coins · '+deaths+' falls';$('win').classList.add('on')}
 const tx=clamp(p.x+12-VW*.42+p.dir*40,0,Math.max(0,WORLD-VW));cam+=(tx-cam)*Math.min(1,dt*6);
}
const fmt=t=>Math.floor(t/60)+':'+(t%60).toFixed(1).padStart(4,'0');
/* ---------- drawing ---------- */
function cloud(x,y,s){ctx.fillStyle='#fff';[[0,0,26],[24,-8,22],[48,0,26],[24,6,26]].forEach(([a,b,r])=>{ctx.beginPath();ctx.arc(x+a*s,y+b*s,r*s,0,7);ctx.fill()});ctx.fillStyle='rgba(120,180,230,.25)';ctx.beginPath();ctx.ellipse(x+24*s,y+22*s,40*s,6*s,0,0,7);ctx.fill()}
function hills(par,col,amp,base,fr,oy){ctx.fillStyle=col;ctx.beginPath();ctx.moveTo(0,VH+10);for(let x=0;x<=VW+10;x+=10){const u=(x+cam*par)*fr;ctx.lineTo(x,oy+base-Math.sin(u)*amp-Math.sin(u*2.3+1)*amp*.4)}ctx.lineTo(VW+10,VH+10);ctx.fill()}
function bg(){const oy=VH-H;const g=ctx.createLinearGradient(0,0,0,VH);g.addColorStop(0,'#58b2ff');g.addColorStop(1,'#d9f5ff');ctx.fillStyle=g;ctx.fillRect(0,0,VW,VH);
 el(VW-100,oy+80,52,52,'rgba(255,240,150,.35)');el(VW-100,oy+80,36,36,'#ffe45e',1);
 const W2=VW+320;for(let i=0;i<6;i++){const x=((i*290-cam*.25)%W2+W2)%W2-160;cloud(x,oy+36+(i%3)*46,.8+(i%2)*.35)}
 hills(.12,'#a6e0c6',46,300,.006,oy);hills(.32,'#74d08f',30,350,.011,oy)}
function bark(x,y,s){ // tree
 rr(x-8*s,y-52*s,16*s,54*s,5,'#a8683a',1);rr(x-3*s,y-48*s,4*s,40*s,2,'#c58650');
 [[0,-72,30],[-20,-56,22],[20,-56,22]].forEach(([a,b,r])=>{ctx.beginPath();ctx.arc(x+a*s,y+b*s,r*s,0,7);ctx.lineWidth=LW;ctx.strokeStyle=INK;ctx.stroke()});
 [[0,-72,30],[-20,-56,22],[20,-56,22]].forEach(([a,b,r])=>{ctx.beginPath();ctx.arc(x+a*s,y+b*s,r*s,0,7);ctx.fillStyle='#4cc15f';ctx.fill()});
 el(x-6*s,y-80*s,10*s,7*s,'#7ee37a',0,-.5);}
function bush(x,y,s){[[-14,0,14],[0,-6,17],[15,0,14]].forEach(([a,b,r])=>{ctx.beginPath();ctx.arc(x+a*s,y+(b-12)*s,r*s,0,7);ctx.lineWidth=LW;ctx.strokeStyle=INK;ctx.stroke()});[[-14,0,14],[0,-6,17],[15,0,14]].forEach(([a,b,r])=>{ctx.beginPath();ctx.arc(x+a*s,y+(b-12)*s,r*s,0,7);ctx.fillStyle='#3fae58';ctx.fill()});el(x-3*s,y-24*s,6*s,4*s,'#78d88a')}
function flowers(x,y,s){[[-10,'#ff6b8b',14],[2,'#ffd25e',20],[13,'#fff',12]].forEach(([a,c,h])=>{ctx.strokeStyle='#2a8a45';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(x+a*s,y);ctx.lineTo(x+a*s,y-h*s);ctx.stroke();for(let i=0;i<5;i++){const an=i*1.256;el(x+a*s+Math.cos(an)*4,y-h*s+Math.sin(an)*4,3.4,3.4,c)}el(x+a*s,y-h*s,2.6,2.6,'#ff9a2e')})}
function block(s){const{x,y,w,h}=s;
 ctx.fillStyle=INK;ctx.beginPath();ctx.roundRect(x-3,y-3,w+6,h+6,10);ctx.fill();
 rr(x,y,w,h,8,'#a8683a');
 for(let i=0;i<w/T;i++)for(let j=1;j<h/T+1&&j<5;j++){const r=((i*7+j*13+(x>>5)*3)%5);if(r<3){const px=x+i*T+8+r*7,py=y+j*T-4-r*3;if(py<y+h-4){el(px,py,5,3.5,'#8a5330');el(px+13,py-8,3,2.2,'#c58650')}}}
 if(h>T*1.5)for(let j=1;j<4;j++){ctx.fillStyle='rgba(60,30,10,.12)';ctx.fillRect(x,y+j*T+22,w,3)}
 ctx.fillStyle=INK;for(let i=0;i<w/16;i++){ctx.beginPath();ctx.arc(x+8+16*i,y+11,11,0,Math.PI);ctx.fill()}ctx.fillRect(x-3,y-3,w+6,12);
 ctx.fillStyle='#4cc15f';ctx.fillRect(x,y,w,11);for(let i=0;i<w/16;i++){ctx.beginPath();ctx.arc(x+8+16*i,y+10,8,0,Math.PI);ctx.fill()}
 ctx.fillStyle='#86e36c';ctx.fillRect(x+3,y+1,w-6,4);
 ctx.fillStyle='#2f9a4b';for(let i=0;i<w/T;i++){ctx.fillRect(x+i*T+9,y-4,3,5);ctx.fillRect(x+i*T+20,y-6,3,7)}}
function mover(m){const{x,y,w}=m;rr(x,y,w,16,7,'#ff9a3d',1);rr(x+3,y+2,w-6,5,3,'#ffc27a');ctx.fillStyle='#fff';for(let i=0;i<4;i++)el(x+10+i*(w-20)/3,y+11,2.4,2.4,'#7a3b10');
 ctx.fillStyle=INK;ctx.fillRect(x+10,y+16,6,5);ctx.fillRect(x+w-16,y+16,6,5)}
function spike(s){for(let i=0;i<2;i++){const x=s.x+i*16;ctx.beginPath();ctx.moveTo(x+1,s.y+T);ctx.lineTo(x+8,s.y+9);ctx.lineTo(x+15,s.y+T);ctx.closePath();ctx.lineJoin='round';ctx.lineWidth=LW;ctx.strokeStyle=INK;ctx.stroke();ctx.fillStyle='#cfd8ec';ctx.fill();ctx.beginPath();ctx.moveTo(x+8,s.y+12);ctx.lineTo(x+13,s.y+T-3);ctx.lineTo(x+8,s.y+T-3);ctx.fillStyle='#9aa7c8';ctx.fill()}}
function drawSpring(){const c=spring.t>0?.55:1,x=spring.x+16,y=spring.y;rr(x-13,y-5,26,5,2,'#6a5acd',1);ctx.strokeStyle=INK;ctx.lineWidth=7;ctx.beginPath();for(let i=0;i<=4;i++)ctx.lineTo(x+(i%2?9:-9),y-5-i*3.2*c);ctx.stroke();ctx.strokeStyle='#ff5a6e';ctx.lineWidth=3.5;ctx.stroke();rr(x-15,y-5-13*c-6,30,7,3,'#ffd25e',1)}
function flag(x,gy,on,goalF){ctx.fillStyle=INK;ctx.fillRect(x-3,gy-(goalF?96:62),6,goalF?96:62);el(x,gy-(goalF?96:62),5,5,'#ffd25e',1);
 const top=gy-(goalF?92:58),w=Math.sin(tA*5)*3,col=goalF?'#fff':on?'#37d66b':'#aab';
 ctx.beginPath();ctx.moveTo(x+3,top);ctx.quadraticCurveTo(x+22,top+4+w,x+40,top+2);ctx.quadraticCurveTo(x+34,top+14,x+40,top+26-w);ctx.quadraticCurveTo(x+22,top+30,x+3,top+26);ctx.closePath();ctx.fillStyle=col;ctx.fill();ctx.lineWidth=LW;ctx.strokeStyle=INK;ctx.stroke();
 if(goalF){ctx.save();ctx.clip();ctx.fillStyle=INK;for(let i=0;i<5;i++)for(let j=0;j<3;j++)if((i+j)%2)ctx.fillRect(x+3+i*8,top+j*9,8,9);ctx.restore();ctx.beginPath();ctx.moveTo(x+3,top);ctx.quadraticCurveTo(x+22,top+4+w,x+40,top+2);ctx.quadraticCurveTo(x+34,top+14,x+40,top+26-w);ctx.quadraticCurveTo(x+22,top+30,x+3,top+26);ctx.closePath();ctx.stroke()}
 rr(x-12,gy-8,24,8,3,'#8a8fb5',1)}
function drawCoin(c,i){const w=Math.abs(Math.cos(tA*3+i*.7))*9+2,y=c.y+Math.sin(tA*3+i)*3;el(c.x,y,w+2.5,13,'#ffd25e',1);el(c.x,y,w*.55,8,'#ffb400');el(c.x-w*.2,y-4,Math.max(w*.18,1),3,'#fff8c8')}
function foot(x,y,col){el(x,y,6.2,4,col,1)}
function arm(x,a,col){ctx.save();ctx.translate(x,-20);ctx.rotate(a);el(0,5,3.6,6,col,1);ctx.restore()}
function drawPlayer(){const p=pl;if(p.dead>0)return;const[c1,c2]=chars[ci];
 const run=p.ground&&Math.abs(p.vx)>25,air=!p.ground,s=Math.sin(p.t),bob=run?-Math.abs(Math.sin(p.t))*1.6:0;
 ctx.save();ctx.translate(p.x+p.w/2,p.y+p.h);
 el(0,0,11,3,'rgba(0,0,0,.0)');
 ctx.scale(p.dir*(1+p.sq*.55),1-p.sq);LW=2.4;
 arm(-11,run?-s*.9:air?(p.vy<0?-2.5:-1.4):.15,c2);
 const lift=a=>run?Math.max(0,a)*4:0;
 foot(-6+(air?-3:s*5),-4-lift(Math.cos(p.t))-(air?(p.vy<0?4:1):0),c2);foot(6+(air?3:-s*5),-4-lift(-Math.cos(p.t))-(air?(p.vy<0?1:4):0),c2);
 rr(-12,-33+bob,24,29,12,c1,1);
 el(0,-10+bob,7.5,6,'rgba(255,255,255,.3)');
 rr(-9,-31+bob,6,3,2,'rgba(255,255,255,.45)');
 el(-2,-37+bob,3,6,'#3fae58',1,-.5);el(3,-36+bob,3,5.4,'#58cf70',1,.6);
 const ey=-22+bob,blink=(tA%3.3)<.12;
 [-4.5,6].forEach(ex=>{if(blink){ctx.beginPath();ctx.moveTo(ex-3.5,ey);ctx.lineTo(ex+3.5,ey);ctx.lineWidth=2;ctx.strokeStyle=INK;ctx.stroke()}else{el(ex,ey,4.3,5.3,'#fff',1);el(ex+1.6,ey+.6+(air?-1:0),2.5,3,INK);el(ex+2.2,ey-.6,.9,.9,'#fff')}});
 el(-8,-15+bob,2.6,1.8,'rgba(255,90,120,.45)');el(11,-15+bob,2.2,1.6,'rgba(255,90,120,.4)');
 ctx.lineWidth=2;ctx.strokeStyle=INK;if(air){el(2,-13+bob,2.4,3,'#7a2740',1)}else{ctx.beginPath();ctx.arc(2,-14.5+bob,3.2,.15,3);ctx.stroke()}
 arm(11,run?s*.9:air?(p.vy<0?2.5:1.4):-.15,c2);
 LW=3;ctx.restore()}
function render(){ctx.setTransform(S,0,0,S,0,0);bg();
 ctx.save();ctx.translate(-Math.round(cam),VH-H);ctx.lineJoin='round';
 const L=cam-120,R=cam+VW+120,vis=o=>o.x>L&&o.x<R,visB=o=>o.x+o.w>L&&o.x<R;
 decor.filter(vis).forEach(d=>[bark,bush,flowers][d.t](d.x,d.y+1,d.s));
 cps.forEach(c=>flag(c.x,c.gy,c.on));flag(goal.x,goal.gy,0,1);
 solids.filter(visB).forEach(block);movers.forEach(mover);
 spikes.filter(vis).forEach(spike);drawSpring();
 coins.forEach((c,i)=>{if(!c.got&&vis(c))drawCoin(c,i)});
 drawPlayer();
 parts.forEach(q=>{ctx.globalAlpha=clamp(q.l/q.m*1.5,0,1);el(q.x,q.y,q.r,q.r,q.c)});ctx.globalAlpha=1;
 ctx.restore()}
function hud(){$('hc').textContent=got+'/'+coins.length;$('ht').textContent=fmt(time);$('hd').textContent=deaths}
let last=0;
function loop(t){const dt=Math.min(.033,(t-last)/1000||0);last=t;update(dt/2);update(dt/2);render();hud();requestAnimationFrame(loop)}
/* ---------- ui ---------- */
$('play').onclick=()=>{$('menu').classList.remove('on');reset();beep(500,.1,'square',.04,900)};
$('again').onclick=()=>{$('win').classList.remove('on');reset()};
$('br').onclick=()=>{if(state=='play')reset();$('br').blur()};
$('bm').onclick=()=>{muted=!muted;$('bm').textContent=muted?'🔇':'🔊';$('bm').blur()};
spawn();update(.01);requestAnimationFrame(loop);
</script>
</body>
</html>
